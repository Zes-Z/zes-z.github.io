---
import globalCss from '../styles/global.css?inline';
import '../styles/katex.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchPalette from '../components/SearchPalette.astro';
import Lightbox from '../components/Lightbox.astro';
import { siteConfig, siteSubtitle } from '../site.config';
import { localize } from '../i18n';
import type { Language } from '../types';
import { withBase } from '../utils/paths';

interface Props {
  lang: Language;
  title?: string;
  description?: string;
  /** Omit the horizontal container so a page can go full-bleed (e.g. hero). */
  fullWidth?: boolean;
}

const { lang, title, description, fullWidth = false } = Astro.props;
const subtitleText = siteSubtitle();
const pageTitle = title
  ? `${title} · ${siteConfig.title}`
  : subtitleText
    ? `${siteConfig.title} — ${localize(subtitleText, lang)}`
    : siteConfig.title;
const pageDescription = description ?? localize(siteConfig.description, lang);
---

<!doctype html>
<html lang={lang} data-lang={lang} data-theme="light" data-code-scheme="light">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Anti-flash theme bootstrap: runs before anything renders.
      // Sets the theme attributes AND an inline background color so the page
      // never flashes white (or the wrong theme) on navigation.
      (function () {
        try {
          var mode = localStorage.getItem('zest-theme') || 'system';
          if (mode === 'system') {
            mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          if (mode !== 'light' && mode !== 'dark') mode = 'light';
          var root = document.documentElement;
          root.setAttribute('data-theme', mode);
          root.setAttribute('data-code-scheme', mode === 'dark' ? 'dark' : 'light');
          root.style.backgroundColor = mode === 'dark' ? '#101218' : '#eef6ef';
        } catch (e) {}
      })();
    </script>
    <!-- 全局样式内联进 HTML,页面在导航切换时立即以完整样式渲染,不再出现"先乱后好"的抽动 -->
    <style is:inline set:html={globalCss} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href={withBase(siteConfig.favicon)} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={withBase(`/${lang}/rss.xml`)} />
    <!-- 圆润艺术字体(仅用于英雄区斜体标题),延迟加载不影响首屏 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@1,500;1,600&display=swap"
    />
    <meta name="theme-color" content="#eef6ef" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="meteors" aria-hidden="true"></div>
    <Header lang={lang} />
    <main id="main" class:list={{ 'main--full': fullWidth }}>
      {fullWidth ? <slot /> : <div class="container-x"><slot /></div>}
    </main>
    <Footer lang={lang} />
    <SearchPalette lang={lang} />
    <Lightbox />
    <script>
      // 背景彩色彗星:生成随机位置/颜色/时长的多条"多巴胺"彗星,
      // 每次导航都重新随机,避免位置固定、颜色单一。
      const rand = (min: number, max: number) => min + Math.random() * (max - min);
      const cometsPalette = [
        'rgba(120, 190, 255, 0.75)', // 天蓝
        'rgba(255, 140, 200, 0.75)', // 粉
        'rgba(200, 140, 255, 0.75)', // 紫
        'rgba(255, 190, 90, 0.75)', // 橙
        'rgba(110, 220, 170, 0.75)', // 薄荷绿
        'rgba(255, 110, 110, 0.7)', // 珊瑚红
        'rgba(255, 225, 120, 0.75)', // 柠檬黄
      ];
      const bindComets = () => {
        const layer = document.querySelector<HTMLElement>('.meteors');
        if (!layer || layer.dataset.ready === 'true') return;
        layer.dataset.ready = 'true';
        for (let n = 0; n < 6; n++) {
          const i = document.createElement('i');
          const color = cometsPalette[Math.floor(Math.random() * cometsPalette.length)]!;
          i.style.setProperty('--comet-color', color);
          i.style.setProperty('--comet-len', `${rand(120, 240)}px`);
          i.style.setProperty('--comet-top', `${rand(4, 92)}%`);
          i.style.setProperty('--comet-dur', `${rand(7, 12)}s`);
          i.style.setProperty('--comet-delay', `-${rand(0, 12)}s`);
          i.style.setProperty('--comet-angle', `${rand(-2, 2)}deg`);
          layer.appendChild(i);
        }
      };
      bindComets();
      document.addEventListener('astro:page-load', bindComets);
    </script>
  </body>
</html>

<script>
  // 代码块右上角"复制"按钮:复制整段代码到剪贴板
  const copyFallback = (text: string, done: () => void) => {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      done();
    } catch {
      /* ignore */
    }
    ta.remove();
  };

  const bindCopyButtons = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((btn) => {
      if (btn.dataset.ready === 'true') return;
      btn.dataset.ready = 'true';
      btn.addEventListener('click', () => {
        const block = btn.closest('.code-block');
        const code = block?.querySelector('pre code');
        if (!code) return;
        const text = code.textContent ?? '';
        const done = () => {
          btn.textContent = '✓';
          window.setTimeout(() => {
            btn.textContent = '⧉';
          }, 1400);
        };
        if (navigator.clipboard?.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(() => copyFallback(text, done));
        } else {
          copyFallback(text, done);
        }
      });
    });
  };

  bindCopyButtons();
  document.addEventListener('astro:page-load', bindCopyButtons);
</script>
