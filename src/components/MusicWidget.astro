---
/**
 * 网易云音乐外链小挂件。
 * 默认收起为圆形音符按钮,点击展开/收起播放器。
 */
const iframeSrc = 'https://music.163.com/outchain/player?type=0&id=18360816925&auto=1&height=90';
---

<div class="music-widget" data-music-widget>
  <div class="music-widget__box" data-music-box hidden>
    <iframe
      title="一起听"
      width="330"
      height="110"
      src={iframeSrc}
      loading="lazy"
      style="border: 0"
    ></iframe>
  </div>
  <button class="music-widget__toggle" type="button" data-music-toggle aria-label="一起听" title="一起听">
    <span class="music-widget__icon">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="12" fill="#C20C0C" />
        <path
          fill="#fff"
          d="M12 3.5v11.2c-.68-.34-1.43-.5-2.2-.5-2.2 0-4 1.63-4 3.65S7.6 21.5 9.8 21.5s4-1.63 4-3.65V8.2h4.5V3.5H12Z"
        />
        <circle cx="9.8" cy="17.65" r="1.6" fill="#fff" opacity="0" />
      </svg>
    </span>
  </button>
</div>

<script>
  const widget = document.querySelector<HTMLElement>('[data-music-widget]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-music-toggle]');
  const box = document.querySelector<HTMLElement>('[data-music-box]');

  if (widget && toggle && box) {
    const sync = (open: boolean) => {
      box.hidden = !open;
      widget.classList.toggle('is-open', open);
      widget.classList.toggle('is-playing', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => sync(Boolean(box.hidden)));
  }
</script>

<style>
  .music-widget {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 70;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  .music-widget__box {
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-strong);
    background: var(--surface);
  }
  .music-widget__box[hidden] {
    display: none;
  }
  .music-widget__box iframe {
    display: block;
    border-radius: 14px;
    background: transparent;
  }

  .music-widget__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    color: var(--text-soft);
    cursor: pointer;
    box-shadow: var(--shadow);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      transform 0.2s ease;
  }
  .music-widget__toggle:hover {
    border-color: #C20C0C;
    transform: scale(1.05);
  }

  .music-widget__icon {
    display: grid;
    place-items: center;
  }
  .music-widget.is-playing .music-widget__icon {
    animation: music-widget-spin 12s linear infinite;
  }

  @keyframes music-widget-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>