---
import { siteConfig } from '../site.config';
import { localize } from '../i18n';
import type { Language } from '../types';
import { withBase } from '../utils/paths';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

// 图标库:footer 配置中的 icon 字段在此选择;新增条目可用 'link' 作为通用图标
const iconSvgs: Record<string, string> = {
  github: `<svg width="19" height="19" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>`,
  email: `<svg width="19" height="19" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2" y="4" width="16" height="12" rx="2.5" stroke="currentColor" stroke-width="1.7"/><path d="m3 6 7 6 7-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  rss: `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill="currentColor" d="M5.5 17a1.5 1.5 0 1 1 0 3a1.5 1.5 0 0 1 0-3m0-14C14.06 3 21 9.94 21 18.5q0 .268-.009.534a1 1 0 0 1-1.999-.068Q19 18.734 19 18.5C19 11.044 12.956 5 5.5 5q-.234 0-.466.008a1 1 0 0 1-.068-1.999Q5.231 3 5.5 3m0 7a8.5 8.5 0 0 1 8.482 9.066a1 1 0 0 1-1.996-.132a6.5 6.5 0 0 0-6.92-6.92a1 1 0 1 1-.132-1.995q.28-.02.566-.019"/></svg>`,
  link: `<svg width="19" height="19" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M8.5 11.5l3-3M9.5 7.5 12 5a3.5 3.5 0 0 1 5 5l-2.5 2.5a3.5 3.5 0 0 1-5 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M10.5 12.5 8 15a3.5 3.5 0 0 1-5-5l2.5-2.5a3.5 3.5 0 0 1 5 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>`,
  cloud: `<svg width="19" height="19" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M6.2 15A3.6 3.6 0 0 1 5.2 8a5 5 0 0 1 9.4-1.5A3.9 3.9 0 0 1 14.3 15H6.2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M10 12V8m0 0-1.8 1.8M10 8l1.8 1.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  wechat: `<svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.297 5.03C5.208 5.03 2 7.75 2 10.945c0 1.875 1.033 3.53 2.648 4.625l-.646 2.017 2.356-1.205c.752.28 1.555.433 2.394.433h.354a4.99 4.99 0 0 1-.13-1.125c0-2.76 2.79-5 6.226-5 .3 0 .594.02.883.058C15.93 6.94 12.91 5.03 9.297 5.03zm-2.664 3.19a.848.848 0 1 1 0 1.696.848.848 0 0 1 0-1.696zm5.328 0a.848.848 0 1 1 0 1.696.848.848 0 0 1 0-1.696zM22 14.555c0-2.57-2.72-4.653-6.074-4.653-3.355 0-6.074 2.083-6.074 4.653s2.719 4.653 6.074 4.653c.668 0 1.313-.106 1.91-.296l1.95.998-.534-1.668c1.266-.92 2.074-2.217 2.074-3.687zm-9.492-.53a.743.743 0 1 1 0 1.486.743.743 0 0 1 0-1.486zm4.526 0a.743.743 0 1 1 0 1.486.743.743 0 0 1 0-1.486z"/></svg>`,
};

const items = siteConfig.footer.map((item) => ({
  href: withBase(typeof item.href === 'function' ? item.href(lang) : item.href),
  label: localize(item.label, lang),
  iconName: item.icon,
  icon: iconSvgs[item.icon] ?? iconSvgs.link,
  external: typeof item.href === 'string' && /^https?:\/\//.test(item.href),
  copyValue: 'wechatId' in item ? item.wechatId : undefined,
}));
---

<footer class="site-footer">
  <div class="container-x footer-inner">
    <nav class="footer-nav" aria-label="footer">
      {
        items.map((item) =>
          item.iconName === 'wechat' ? (
            <button
              class="footer-link"
              type="button"
              data-copy-wechat
              data-copy-value={item.copyValue}
              aria-label={item.label}
              title={item.label}
            >
              <span class="footer-icon" set:html={item.icon} />
            </button>
          ) : (
            <a
              class="footer-link"
              href={item.href}
              aria-label={item.label}
              title={item.label}
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="footer-icon" set:html={item.icon} />
            </a>
          )
        )
      }
    </nav>
  </div>
</footer>

<div class="footer-toast" data-copy-toast role="status"></div>

<script>
  const wechatBtn = document.querySelector<HTMLButtonElement>('[data-copy-wechat]');
  const toast = document.querySelector<HTMLElement>('[data-copy-toast]');
  if (wechatBtn && toast) {
    let toastTimer: number | undefined;
    wechatBtn.addEventListener('click', async () => {
      const wechatId = wechatBtn.dataset.copyValue ?? '';
      try {
        await navigator.clipboard.writeText(wechatId);
        toast.textContent = `已复制微信号:${wechatId}`;
        toast.classList.add('is-visible');
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toast.classList.remove('is-visible');
        }, 1800);
      } catch {
        /* clipboard unavailable */
      }
    });
  }
</script>


<style>
  .site-footer {
    margin-top: 3rem;
    /* 与背景融为一体:无底色,仅一根"中间明显、两边淡"的细线区隔 */
    background: transparent;
    border-top: 1px solid transparent;
    border-image: linear-gradient(90deg, transparent, var(--border-strong) 50%, transparent) 1;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
    text-align: center;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.1rem;
  }

  .footer-link {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-soft);
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }
  .footer-link:hover {
    color: var(--hover);
    border-color: var(--hover);
    background: color-mix(in srgb, var(--hover) 14%, transparent);
  }

  .footer-icon {
    display: grid;
    place-items: center;
  }
  .footer-icon :global(svg) {
    display: block;
  }

  .footer-toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translate(-50%, 12px);
    z-index: 80;
    padding: 9px 18px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--text) 88%, transparent);
    color: var(--bg);
    font-size: 0.88rem;
    font-weight: 600;
    box-shadow: var(--shadow-strong);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }
  .footer-toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>
