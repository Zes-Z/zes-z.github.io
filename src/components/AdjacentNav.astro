---
interface AdjacentItem {
  href: string;
  title: string;
  image?: string;
  date?: string;
  tags?: string[];
  category?: string;
  /** CSS aspect-ratio: "1 / 1" or "3 / 2". */
  ratio?: string;
}

interface Props {
  prev?: AdjacentItem;
  next?: AdjacentItem;
}

const { prev, next } = Astro.props;
---

<nav class:list={['adjacent-nav', { 'has-prev': Boolean(prev), 'has-next': Boolean(next) }]}>
  {
    prev && (
      <a class="adjacent-card" href={prev.href}>
        <span class="adjacent-media" style={`aspect-ratio: ${prev.ratio ?? '3 / 2'}`}>
          {prev.image ? (
            <img class="adjacent-img" src={prev.image} alt="" loading="lazy" decoding="async" />
          ) : (
            <span class="adjacent-fallback" aria-hidden="true"></span>
          )}
        </span>
        <span class="adjacent-veil"></span>
        <span class="adjacent-caption">
          {prev.date && <time>{prev.date}</time>}
          <span class="adjacent-title">{prev.title}</span>
          <span class="adjacent-chips">
            {
              prev.tags?.length
                ? prev.tags.map((tag) => <span class="adjacent-chip">{tag}</span>)
                : prev.category && <span class="adjacent-chip">{prev.category}</span>
            }
          </span>
        </span>
      </a>
    )
  }

  {
    next && (
      <a class="adjacent-card" href={next.href}>
        <span class="adjacent-media" style={`aspect-ratio: ${next.ratio ?? '3 / 2'}`}>
          {next.image ? (
            <img class="adjacent-img" src={next.image} alt="" loading="lazy" decoding="async" />
          ) : (
            <span class="adjacent-fallback" aria-hidden="true"></span>
          )}
        </span>
        <span class="adjacent-veil"></span>
        <span class="adjacent-caption">
          {next.date && <time>{next.date}</time>}
          <span class="adjacent-title">{next.title}</span>
          <span class="adjacent-chips">
            {
              next.tags?.length
                ? next.tags.map((tag) => <span class="adjacent-chip">{tag}</span>)
                : next.category && <span class="adjacent-chip">{next.category}</span>
            }
          </span>
        </span>
      </a>
    )
  }
</nav>

<style>
  .adjacent-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .adjacent-nav.has-prev:not(.has-next),
  .adjacent-nav.has-next:not(.has-prev) {
    grid-template-columns: minmax(0, 1fr);
  }

  /* 与归档瀑布流的 masonry-card 保持一致 */
  .adjacent-card {
    position: relative;
    display: block;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    background: var(--surface-2);
  }

  /* 与 masonry-media 一致:图片区域在正常文档流中撑起卡片高度 */
  .adjacent-media {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    background: var(--surface-2);
  }

  .adjacent-img,
  .adjacent-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .adjacent-img {
    display: block;
  }
  .adjacent-card:hover .adjacent-img {
    transform: scale(1.06);
  }
  .adjacent-fallback {
    background:
      radial-gradient(circle at 30% 20%, var(--accent-soft), transparent 45%),
      linear-gradient(135deg, var(--surface-2), var(--surface));
  }

  .adjacent-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, transparent 72%, rgba(10, 12, 16, 0.32));
  }

  /* 与 masonry-caption 一致:左下角三行信息 */
  .adjacent-caption {
    position: absolute;
    z-index: 2;
    inset: auto 12px 12px;
    max-width: calc(100% - 24px);
    display: flex;
    flex-direction: column;
    gap: 3px;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }
  .adjacent-caption time {
    font-size: 0.7rem;
    opacity: 0.85;
  }

  .adjacent-title {
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
  }

  .adjacent-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
  }
  .adjacent-chip {
    padding: 1px 8px;
    border-radius: 999px;
    font-size: 0.7rem;
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }
</style>