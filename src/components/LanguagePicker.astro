---
import { siteConfig } from '../site.config';
import { t } from '../i18n';
import type { Language } from '../types';
import { localizePath } from '../utils/paths';

interface Props {
  lang: Language;
  pathname: string;
}

const { lang, pathname } = Astro.props;

// 单击轮换:中文 → English → 日本語 → 中文 …
const langs = siteConfig.langs;
const next = langs[(langs.indexOf(lang) + 1) % langs.length]!;
const nextLabel = t(next, 'lang.name');
---

<language-picker>
  <a
    class="icon-btn lang-btn"
    href={localizePath(pathname, next)}
    title={`${t(lang, 'lang.switch')} → ${nextLabel}`}
    aria-label={`${t(lang, 'lang.switch')} → ${nextLabel}`}
  >
    <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <circle cx="10" cy="10" r="6.8" stroke="currentColor" stroke-width="1.8"></circle>
      <path d="M3.2 10h13.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      <ellipse cx="10" cy="10" rx="3" ry="6.8" stroke="currentColor" stroke-width="1.8"></ellipse>
    </svg>
  </a>
</language-picker>

<style>
  language-picker {
    display: inline-flex;
  }

  .lang-btn {
    width: 36px;
    height: 36px;
  }
</style>
