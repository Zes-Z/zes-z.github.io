---
import { siteConfig } from '../site.config';
import { t } from '../i18n';
import type { Language } from '../types';
import { localizePath } from '../utils/paths';

interface Props {
  lang: Language;
  pathname: string;
}

const { lang, pathname } = Astro.props;

// 单击轮换:中文 → English → 日本語 → 中文 …
const langs = siteConfig.langs;
const next = langs[(langs.indexOf(lang) + 1) % langs.length]!;
const nextLabel = t(next, 'lang.name');
---

<language-picker>
  <a
    class="icon-btn lang-btn"
    href={localizePath(pathname, next)}
    title={`${t(lang, 'lang.switch')} → ${nextLabel}`}
    aria-label={`${t(lang, 'lang.switch')} → ${nextLabel}`}
  >
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M17 3l4 4-4 4M21 7H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M7 21l-4-4 4-4M3 17h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <span class="lang-current">{lang.toUpperCase()}</span>
  </a>
</language-picker>

<style>
  language-picker {
    display: inline-flex;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: auto;
    height: 38px;
    padding: 0 12px;
  }

  .lang-current {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
</style>
